# ── Jarvis configuration ────────────────────────────────────────────────
# Secrets live here (or in a real secrets manager) and NEVER in code,
# logs, or prompts. Spec §10.

JARVIS_ENV=local
JARVIS_LOG_LEVEL=INFO

# Persistence
JARVIS_DATABASE_URL=postgresql+asyncpg://jarvis:jarvis@localhost:5432/jarvis
JARVIS_REDIS_URL=redis://localhost:6379/0

# Workflow runtime (spec §2 — Temporal)
JARVIS_TEMPORAL_HOST=localhost:7233
JARVIS_TEMPORAL_NAMESPACE=default
JARVIS_TEMPORAL_TASK_QUEUE=jarvis-platform

# ── LLM provider selection (Directive: change by CONFIG ONLY) ───────────
# One of: anthropic | openai | gemini | kimi | ollama | openrouter | lmstudio
JARVIS_LLM__PROVIDER=anthropic
JARVIS_LLM__MODEL=<set-your-model-id>
JARVIS_LLM__API_KEY=
# Optional override; each provider has a sane default base URL.
JARVIS_LLM__BASE_URL=
JARVIS_LLM__TIMEOUT_SECONDS=120

# ── Budget ceilings (spec §9 + decision D-003) ─────────────────────────
JARVIS_BUDGET__PLATFORM_ROLLING_24H_USD=500.00
JARVIS_BUDGET__DEFAULT_WAKE_CYCLE_CEILING_USD=1.00

# ── Development lanes (D-026.2) ─────────────────────────────────────────
# Two implementation lanes can run the full gate suite against the same
# local Docker stack at once because each gets its own database, Temporal
# namespace, and API port instead of the defaults above. `scripts/lane_env.py
# create <lane-id>` provisions those three and prints this block for the
# lane's own .env; `destroy <lane-id>` removes them. Leave unset for the
# single-developer default (JARVIS_DATABASE_URL's `jarvis` DB, the `default`
# namespace, port 8000) — that default is never a valid lane target.
# JARVIS_DATABASE_URL=postgresql+asyncpg://jarvis:jarvis@localhost:5432/jarvis_lane_<lane-id>
# JARVIS_TEST_DATABASE_URL=postgresql+asyncpg://jarvis:jarvis@localhost:5432/jarvis_lane_<lane-id>
# JARVIS_TEMPORAL_NAMESPACE=lane-<lane-id>
# JARVIS_API_PORT=8000
